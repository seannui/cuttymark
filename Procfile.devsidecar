web: bin/wait-for-pg bin/rails server -p 3400
jobs: bin/rails solid_queue:start
whisper: ${WHISPER_SERVER_PATH:-/Users/sporter/git/whisper.cpp/build/bin/whisper-server} -m ${WHISPER_MODEL_PATH:-/Users/sporter/git/whisper.cpp/models/ggml-large-v3.bin} --host ${WHISPER_HOST:-127.0.0.1} --port ${WHISPER_PORT:-3333} -t 16 -p 8 --convert 2>&1 | tee -a log/whisper.log
ollama: OLLAMA_HOST=${OLLAMA_HOST:-127.0.0.1}:${OLLAMA_PORT:-11434} OLLAMA_FLASH_ATTENTION="1" OLLAMA_KV_CACHE_TYPE="q8_0" /opt/homebrew/opt/ollama/bin/ollama serve
