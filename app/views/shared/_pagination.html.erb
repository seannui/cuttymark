<% if collection.total_pages > 1 %>
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 px-4 py-3 sm:px-6">
    <div class="flex items-center justify-between">
      <div class="text-sm text-gray-700">
        Showing <span class="font-medium"><%= collection.offset_value + 1 %>-<%= [collection.offset_value + collection.limit_value, collection.total_count].min %></span> of
        <span class="font-medium"><%= collection.total_count %></span> results
      </div>
      <div class="flex space-x-2">
        <%= paginate collection %>
      </div>
    </div>
  </div>
<% end %>
